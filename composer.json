{
    "name": "fsans/fms-odata-spec-php",
    "description": "Shared PHP types and spec definitions for the Claris FileMaker Server OData API. Mirrors @fms-odata/spec-ts (npm) and fms-odata-spec (PyPI). Types + pure helpers only; no HTTP client, no validation framework.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0",
        "phpstan/phpstan": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "FmsOData\\Spec\\": "packages/fms-odata-spec-php/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FmsOData\\Spec\\Tests\\": "packages/fms-odata-spec-php/tests/"
        }
    },
    "scripts": {
        "test": "phpunit -c packages/fms-odata-spec-php/phpunit.xml.dist",
        "analyse": "phpstan analyse -c packages/fms-odata-spec-php/phpstan.neon.dist",
        "check": [
            "@test",
            "@analyse"
        ]
    },
    "scripts-descriptions": {
        "test": "Run the PHPUnit test suite",
        "analyse": "Run PHPStan static analysis at level max",
        "check": "Run tests and static analysis"
    }
}
